# =====================================================================
# Supabase. Copiá este archivo a .env.local y completá con tus valores.
# (Supabase Dashboard → Project Settings → API)
# Sin estas variables, el sitio funciona con el menú mock y el panel /admin
# queda deshabilitado.
# =====================================================================

# Públicas (se exponen al navegador, es correcto):
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# SOLO servidor — NUNCA agregar el prefijo NEXT_PUBLIC a esta.
# Es la "service_role key". Bypassa RLS; se usa para guardar pedidos.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
